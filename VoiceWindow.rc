// Version information and manifest of VoiceWindow.exe (shown in the file properties, and used by Windows and
// antivirus programs to recognize a normal, identifiable program).
1 24 "VoiceWindow.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Success Craft"
            VALUE "FileDescription", "Voice Recognition and Translation"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "VoiceWindow"
            VALUE "LegalCopyright", "Copyright (c) 2026 Success Craft. MIT License."
            VALUE "OriginalFilename", "VoiceWindow.exe"
            VALUE "ProductName", "Voice Recognition and Translation"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "Open source: https://github.com/powervac/Success-Craft-Voice-Recognition-and-Translation-Online"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
